// A page that shows the viewer sends a visitor who hasn't picked one to
// {{.Picker}} here, before the page renders, so it's a real redirect. It only
// checks the cookie is there; needViewer catches a viewer that's gone.
import { NextResponse, type NextRequest } from "next/server";

export function proxy(request: NextRequest) {
    if (!request.cookies.has("{{.Cookie}}")) {
        return NextResponse.redirect(new URL({{.PickerJS}}, request.url));
    }
    return NextResponse.next();
}

