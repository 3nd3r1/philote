"use server";

// Generated by philote from component {{.Component}}'s calls. Do not edit.
import * as api from "@/lib/api";
import { message } from "@/lib/form";
{{- if .Viewer}}
import { needViewer } from "@/lib/viewer";
{{- end}}

// {{.Func}} calls the {{.Endpoint}} endpoint{{if .Viewer}} as the viewer{{end}}. It returns the error
// to show, or undefined when it worked.
export async function {{.Func}}({{.Params}}): Promise<string | undefined> {
{{- if .Viewer}}
    const viewer = await needViewer();
{{- end}}
    const result = await api.{{.Func}}({{.Input}});
    return result.ok ? undefined : message(result.error);
}
