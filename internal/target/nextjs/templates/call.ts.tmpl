"use server";

// Generated by philote from component {{.Component}}'s calls. Do not edit.
import * as api from "@/lib/api";
import { message } from "@/lib/form";
{{- if .Types}}
import type { {{.Types}} } from "@/lib/types";
{{- end}}
{{- if .Viewer}}
import { needViewer } from "@/lib/viewer";
{{- end}}

// {{.Result}} is what a call to {{.Endpoint}} did: {{if .Value}}what it made{{else}}nothing to show{{end}}, or the
// error to show.
export type {{.Result}} = {{if .Value}}{ ok: true; value: {{.Value}} }{{else}}{ ok: true }{{end}} | { ok: false; error: string };

// {{.Func}} calls the {{.Endpoint}} endpoint{{if .Viewer}} as the viewer{{end}}.
export async function {{.Func}}({{.Params}}): Promise<{{.Result}}> {
{{- if .Viewer}}
    const viewer = await needViewer();
{{- end}}
    const result = await api.{{.Func}}({{.Input}});
    return result.ok ? {{if .Value}}{ ok: true, value: result.value }{{else}}{ ok: true }{{end}} : { ok: false, error: message(result.error) };
}
