"use server";

// Generated by philote from component {{.Component}}'s delete. Do not edit.
{{- if .Then}}
import { redirect } from "next/navigation";
{{- end}}

import { {{.Client}} } from "@/lib/api";
import { message } from "@/lib/form";

// remove deletes the record. A record that's already gone counts as
// deleted; any other error comes back as the message to show.
export async function remove(id: string): Promise<string | undefined> {
    const result = await {{.Client}}.delete(id);
    if (!result.ok && result.error !== "not_found") {
        return message(result.error);
    }
{{- if .Then}}
    redirect({{.Then}});
{{- else}}
    return undefined;
{{- end}}
}
