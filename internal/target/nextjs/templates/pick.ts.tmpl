import { cookies } from "next/headers";
import { redirect } from "next/navigation";

import { viewerCookie } from "@/lib/viewer";

// pick makes a {{.Entity}} the viewer for a year, then opens {{.Then}}.
export async function pick(id: string): Promise<void> {
    (await cookies()).set(viewerCookie, id, {
        path: "/",
        httpOnly: true,
        sameSite: "lax",
        maxAge: 60 * 60 * 24 * 365,
    });
    redirect({{.ThenJS}});
}
