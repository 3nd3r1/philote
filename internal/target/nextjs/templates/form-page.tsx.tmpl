// Generated by philote from page {{.Route}}. PageBody's body is written by
// a model and pinned in philote.lock (decision-2).
/* eslint-disable @typescript-eslint/no-unused-vars -- every page gets the same imports */
import type { Metadata } from "next";
{{- if .ByID}}
import { notFound } from "next/navigation";
{{- end}}
import { connection } from "next/server";
import { Suspense } from "react";
{{template "page-imports"}}
{{if .PageClients}}
import { {{.PageClients}} } from "@/lib/api";
{{- end}}
{{- if .Options}}
import { must } from "@/lib/backend";
{{- end}}
{{- if .LocalDateTime}}
import { localDateTime } from "@/lib/form";
{{- end}}
{{- template "page-ui-imports"}}

import { submit } from "./actions";
import Form from "./form";

export const metadata: Metadata = { title: {{.Title}} };
{{if .ByID}}
export default function Page({ params }: PageProps<"{{.Route}}">) {
{{- else}}
export default function Page() {
{{- end}}
    return (
        <main className="flex flex-1 flex-col">
            <PageBody
                title={{"{"}}{{.Title}}{{"}"}}
                content={(className) => (
                    <div className={className}>
                        <Suspense fallback={<p className="text-muted-foreground">Loading…</p>}>
                            <Loaded{{if .ByID}} params={params}{{end}} />
                        </Suspense>
                    </div>
                )}
            />
        </main>
    );
}

// Loaded fills the form once its record and choices are in.
{{- if .ByID}}
async function Loaded({ params }: Pick<PageProps<"{{.Route}}">, "params">) {
    await connection();
    const { id } = await params;
    const result = await {{.Client}}.get(id);
    if (!result.ok) {
        notFound();
    }
    const record = result.value;
{{- else}}
async function Loaded() {
    await connection();
{{- end}}
{{- if .Options}}
    const options = {
{{- range .Options}}
        {{.Name}}: (await must({{.Client}}.list())).map((r) => ({ id: r.id, label: {{.Label}} })),
{{- end}}
    };
{{- else}}
    const options = {};
{{- end}}
{{- if .ByID}}
    const initial = {
{{- range .Fields}}
        {{.Name}}: {{.Initial}},
{{- end}}
    };
    return <Form action={submit.bind(null, id)} initial={initial} options={options} />;
{{- else}}
    return <Form action={submit} initial={{"{{}}"}} options={options} />;
{{- end}}
}
{{- template "page-body" .}}
