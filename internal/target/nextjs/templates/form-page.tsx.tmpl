// Loaded fills the form once its record and choices are in.
{{- if .ByID}}
async function Loaded({ params }: Pick<PageProps<"{{.Route}}">, "params">) {
    await connection();
    const { id } = await params;
    const result = await {{.Client}}.get(id);
    if (!result.ok) {
        notFound();
    }
    const record = result.value;
{{- else}}
async function Loaded() {
    await connection();
{{- end}}
{{- if .Options}}
    const options = {
{{- range .Options}}
        {{.Name}}: (await must({{.Client}}.list())).map((r) => ({ id: r.id, label: {{.Label}} })),
{{- end}}
    };
{{- else}}
    const options = {};
{{- end}}
{{- if .ByID}}
    const initial = {
{{- range .Fields}}
        {{.Name}}: {{.Initial}},
{{- end}}
    };
    return <Form action={submit.bind(null, id)} initial={initial} options={options} />;
{{- else}}
    return <Form action={submit} initial={{"{{}}"}} options={options} />;
{{- end}}
}
