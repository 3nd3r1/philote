import type { Metadata } from "next";
import { connection } from "next/server";
import { Suspense } from "react";

import { {{.Client}} } from "@/lib/api";
import { must } from "@/lib/backend";
import { {{.Read}} } from "@/lib/reads";

import {{.Component}} from "@/components/common/{{.ComponentFile}}";

export const metadata: Metadata = { title: {{.Title}} };

export default function Page() {
    return (
        <main className="flex-1 p-8">
            <div className="mx-auto max-w-4xl space-y-6">
                <h1 className="font-heading text-4xl">{{"{"}}{{.Title}}{{"}"}}</h1>
                <Suspense fallback={<p className="text-muted-foreground">Loading…</p>}>
                    <Records />
                </Suspense>
            </div>
        </main>
    );
}

async function Records() {
    await connection();
    const records = await must({{.Client}}.list());
    if (records.length === 0) {
        return <p className="text-muted-foreground">{{"{"}}{{.Empty}}{{"}"}}</p>;
    }
    const items = await Promise.all(records.map({{.Read}}));
    return (
        <div className="grid gap-4 md:grid-cols-2">
            {items.map((item) => (
                <{{.Component}} key={item.{{.Param}}.id} {...item} />
            ))}
        </div>
    );
}
