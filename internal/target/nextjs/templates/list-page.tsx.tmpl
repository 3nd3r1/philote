// Generated by philote from page {{.Route}}. PageBody's body is written by
// a model and pinned in philote.lock (decision-2).
/* eslint-disable @typescript-eslint/no-unused-vars -- every page gets the same imports */
import type { Metadata } from "next";
import { connection } from "next/server";
import { Suspense } from "react";
{{template "page-imports"}}

import { {{.Client}} } from "@/lib/api";
import { must } from "@/lib/backend";
import { {{.Read}} } from "@/lib/reads";
{{- template "page-ui-imports"}}

import {{.Component}} from "@/components/common/{{.ComponentFile}}";

export const metadata: Metadata = { title: {{.Title}} };

export default function Page() {
    return (
        <main className="flex flex-1 flex-col">
            <PageBody
                title={{"{"}}{{.Title}}{{"}"}}
                content={(className) => (
                    <Suspense fallback={<p className="text-muted-foreground">Loading…</p>}>
                        <Records className={className} />
                    </Suspense>
                )}
            />
        </main>
    );
}

// Records puts every card in one element with the layout's class, so the
// layout decides how the cards are arranged.
async function Records({ className }: { className: string }) {
    await connection();
    const records = await must({{.Client}}.list());
    if (records.length === 0) {
        return <p className="text-muted-foreground">{{"{"}}{{.Empty}}{{"}"}}</p>;
    }
    const items = await Promise.all(records.map({{.Read}}));
    return (
        <div className={className}>
            {items.map((item) => (
                <{{.Component}} key={item.{{.Param}}.id} {...item} />
            ))}
        </div>
    );
}
{{- template "page-body" .}}
