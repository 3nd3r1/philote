"use client";

// Generated by philote from page {{.Route}}. Do not edit.
import { useActionState } from "react";

import type { FormState } from "@/lib/form";

{{.UIImports}}

import FormField from "@/components/common/form-field";
import SubmitButton from "@/components/common/submit-button";

{{- if .Options}}

type Option = { id: string; label: string };
{{- end}}

export default function Form({
    action,
    initial,
    options,
}: {
    action: (state: FormState, data: FormData) => Promise<FormState>;
    initial: Record<string, string>;
    options: {{if .Options}}{{"{"}}{{range .Options}} {{.Name}}: Option[];{{end}} {{"}"}}{{else}}Record<string, never>{{end}};
}) {
    const [state, submit] = useActionState(action, {});
    const values = state.values ?? initial;
    return (
        <form action={submit} className="space-y-6">
{{- range .Fields}}
            <FormField name="{{.Name}}" label={{"{"}}{{.Label}}{{"}"}} issue={state.issues?.{{.Name}}}>
{{- if eq .Control "input"}}
                <Input id="{{.Name}}" name="{{.Name}}" type="{{.Type}}"{{.Attrs}} defaultValue={values.{{.Name}}} aria-invalid={!!state.issues?.{{.Name}}} />
{{- else if eq .Control "textarea"}}
                <Textarea id="{{.Name}}" name="{{.Name}}"{{.Attrs}} defaultValue={values.{{.Name}}} aria-invalid={!!state.issues?.{{.Name}}} />
{{- else if eq .Control "checkbox"}}
                <input id="{{.Name}}" name="{{.Name}}" type="checkbox" defaultChecked={values.{{.Name}} === "on"} className="size-4 accent-primary" />
{{- else if eq .Control "select"}}
                <NativeSelect id="{{.Name}}" name="{{.Name}}"{{.Attrs}} defaultValue={values.{{.Name}} ?? ""} aria-invalid={!!state.issues?.{{.Name}}} className="w-full">
                    <NativeSelectOption value="">Choose…</NativeSelectOption>
{{- range .Choices}}
                    <NativeSelectOption value="{{.}}">{{.}}</NativeSelectOption>
{{- end}}
                </NativeSelect>
{{- else}}
                <NativeSelect id="{{.Name}}" name="{{.Name}}"{{.Attrs}} defaultValue={values.{{.Name}} ?? ""} aria-invalid={!!state.issues?.{{.Name}}} className="w-full">
                    <NativeSelectOption value="">Choose…</NativeSelectOption>
                    {options.{{.Name}}.map((o) => (
                        <NativeSelectOption key={o.id} value={o.id}>
                            {o.label}
                        </NativeSelectOption>
                    ))}
                </NativeSelect>
{{- end}}
            </FormField>
{{- end}}
            {state.error && <p role="alert" className="text-sm text-destructive">{state.error}</p>}
            <SubmitButton>Save</SubmitButton>
        </form>
    );
}
