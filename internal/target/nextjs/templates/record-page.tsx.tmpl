// Record streams in after the page's shell, so a missing record renders
// not-found.tsx with noindex, but the response status stays 200.
async function Record({ params }: Pick<PageProps<"{{.Route}}">, "params">) {
    await connection();
    const { id } = await params;
    const result = await {{.Client}}.get(id);
    if (!result.ok) {
        notFound();
    }
    const item = await {{.Read}}(result.value);
    return <{{.Component}} {...item} />;
}
