// Generated by philote. Do not edit.
// The viewer is the {{.Entity}} a visitor picked{{if .Picker}} on {{.Picker}}{{end}}, kept in a cookie
// until auth replaces the picker.
{{- if .Picker}}
import { cookies } from "next/headers";
import { redirect } from "next/navigation";

import * as api from "@/lib/api";
import type { {{.Entity}} } from "@/lib/types";
{{- end}}

export const viewerCookie = "{{.Cookie}}";
{{- if .Picker}}

// needViewer returns the viewer, or sends the visitor to pick one when they
// haven't, or the one they picked is gone.
export async function needViewer(): Promise<{{.Entity}}> {
    const id = (await cookies()).get(viewerCookie)?.value;
    if (id) {
        const result = await api.{{.Client}}.get(id);
        if (result.ok) {
            return result.value;
        }
    }
    redirect({{.PickerJS}});
}
{{- end}}
