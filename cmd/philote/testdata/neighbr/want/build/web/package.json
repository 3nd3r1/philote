        "react": "19.3.1",
        "react-dom": "19.3.1",
        "server-only": "0.0.1",
        "sonner": "2.0.8",
        "zod": "4.6.7"
    },
    "overrides": {
        "minimatch": "10.2.6"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "4.3.4",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.5",
        "prettier": "3.9.10",
