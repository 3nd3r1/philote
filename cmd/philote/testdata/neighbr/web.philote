uses: api
look: "a warm, playful dating app: coral and cream, soft rounded cards, friendly rounded type"
viewer: Horse
nav: bottom, "/swipe", "/horses", "/matches", "/me" as "Me"

page "/" {
  load: horses
  shows: Landing, list of HorseCard(horses)
  empty: "No horses yet."
}

page "/pick" {
  load: horses
  shows: HorsePicker(horses), JoinHerd
  empty: "No horses yet."
}

page "/me" {
  shows: HorseView(viewer)
}

page "/horses" {
  load: horses
  shows: list of HorseCard(horses)
  empty: "No horses yet."
}

page "/horses/[id]" {
  load: horse from horses by id
  shows: HorseView(horse)
  not_found: "That horse doesn't exist."
}

page "/matches" {
  load: matches from matches_of(horse: viewer)
  shows: list of MatchCard(matches)
  empty: "No matches yet. Keep swiping."
}

page "/horses/new" {
  form: horses.create
  then: "/horses/[id]"
}

page "/horses/[id]/edit" {
  form: horses.update by id
  then: "/horses/[id]"
  not_found: "That horse doesn't exist."
}

page "/swipe" {
  load: deck from candidates(horse: viewer)
  shows: SwipeDeck(deck)
  empty: "You've seen every horse. Check back later."
}

component Landing {
  says: "Find your herd.", "Swipe on horses near you. Match when it's mutual."
  links_to: "/pick" as "Start swiping"
  look: "a full-width hero: the headline huge, the line under it, one big button"
}

component HorsePicker(horses: list of Horse) {
  shows: horses.name, horses.breed
  says: "Who are you?"
  picks: viewer then "/swipe"
  look: "a grid of round avatars, the first letter of the name large on a soft tint, the name under it; tap one"
}

component JoinHerd {
  says: "Not in the herd yet?"
  links_to: "/horses/new" as "Add your horse"
  look: "a small centered line with a quiet button, under the picker"
}

component SwipeDeck(deck: list of Horse) {
  shows: deck.name, deck.age, deck.breed, deck.bio
  says: "You've seen every horse. Check back later."
  calls: swipe(horse: viewer, target: deck, liked)
  look: "tinder: one big card at a time, drag right to like, left to pass, round ✕ and ♥ buttons under it, the next card peeking behind"
}

component HorseCard(horse: Horse) {
  shows: horse.name, horse.breed, horse.age
  links_to: "/horses/[horse.id]"
  look: "a dating-app profile card: where a photo would go, the first letter of the name large on a soft tint of the primary color; under it the name big with the age beside it, the breed as a badge"
}

component HorseView(horse: Horse) {
  shows: horse.name, horse.handle, horse.breed, horse.age, horse.bio
  actions: open "/horses/[horse.id]/edit", delete then "/horses"
  look: "a full dating profile: name and age as a big headline, @handle muted under it, breed badge, the bio as an about section"
}

component MatchCard(match: Match) {
  shows: match.first, match.second, match.matched_at
  look: "celebrate the match: both names large with a heart icon between them, when they matched small and muted"
}
