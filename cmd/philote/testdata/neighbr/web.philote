uses: api
theme: warm
viewer: Horse
nav: bottom, "/swipe", "/horses", "/matches", "/me" as "Me"

page "/" {
  load: horses
  shows: Landing, list of HorseCard(horses)
  empty: "No horses yet."
}

page "/pick" {
  load: horses
  shows: HorsePicker(horses), JoinHerd
  empty: "No horses yet."
}

page "/me" {
  shows: HorseView(viewer)
}

page "/horses" {
  load: horses
  shows: list of HorseCard(horses)
  empty: "No horses yet."
}

page "/horses/[id]" {
  load: horse from horses by id
  shows: HorseView(horse)
  not_found: "That horse doesn't exist."
}

page "/matches" {
  load: matches from matches_of(horse: viewer)
  shows: list of MatchCard(matches)
  empty: "No matches yet. Keep swiping."
}

page "/horses/new" {
  form: horses.create
  then: "/horses/[id]"
}

page "/horses/[id]/edit" {
  form: horses.update by id
  then: "/horses/[id]"
  not_found: "That horse doesn't exist."
}

page "/swipe" {
  load: deck from candidates(horse: viewer)
  shows: SwipeDeck(deck)
  empty: "You've seen every horse. Check back later."
}

component Landing: hero {
  says: "Find your herd.", "Swipe on horses near you. Match when it's mutual."
  links_to: "/pick" as "Start swiping"
}

component HorsePicker(horses: list of Horse): picker {
  shows: horses.name, horses.breed
  says: "Who are you?"
  picks: viewer then "/swipe"
}

component JoinHerd: callout {
  says: "Not in the herd yet?"
  links_to: "/horses/new" as "Add your horse"
}

component SwipeDeck(deck: list of Horse): deck {
  shows: deck.name, deck.age, deck.breed, deck.bio
  says: "You've seen every horse. Check back later.", "It's a match!", "Keep swiping"
  calls: swipe(horse: viewer, target: deck, liked)
}

component HorseCard(horse: Horse): card {
  shows: horse.name, horse.breed, horse.age
  links_to: "/horses/[horse.id]"
}

component HorseView(horse: Horse): detail {
  shows: horse.name, horse.handle, horse.breed, horse.age, horse.bio
  actions: open "/horses/[horse.id]/edit", delete then "/horses"
}

component MatchCard(match: Match): card {
  shows: match.first, match.second, match.matched_at
}
