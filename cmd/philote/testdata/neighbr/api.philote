resource horses: Horse
resource swipes: Swipe { only: list, create }
resource matches: Match { only: list, get }

endpoint swipe {
  route: POST "/swipe"
  input: { horse: Horse, target: Horse, liked: bool }
  output: { swipe: Swipe, match: Match optional }
  errors: same_horse, already_swiped
  steps: record_swipe, match_if_mutual
}

step record_swipe(horse: Horse, target: Horse, liked: bool) -> swipe: Swipe {
  fails: same_horse, already_swiped
  writes: Swipe
  intent: "store the swipe; a horse can't swipe itself, or swipe the same horse twice"
}

step match_if_mutual(swipe: Swipe) -> match: Match optional {
  reads: Swipe
  writes: Match
  intent: "if this swipe is a like and the target already liked the swiper, create and return a Match for the two, matched now; else null"
}

endpoint candidates {
  route: GET "/horses/[horse]/candidates"
  input: { horse: Horse }
  output: list of Horse
  steps: pick_candidates
}

step pick_candidates(horse: Horse) -> horses: list of Horse {
  reads: Horse, Swipe
  intent: "every other horse this one hasn't swiped on yet"
}

endpoint matches_of {
  route: GET "/horses/[horse]/matches"
  input: { horse: Horse }
  output: list of Match
  steps: find_matches
}

step find_matches(horse: Horse) -> matches: list of Match {
  reads: Match
  intent: "every match this horse is in, newest first"
}
